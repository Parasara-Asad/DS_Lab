  "merge sort": {
    "prefix": "merge sort",
    "body": [
      "void merge(int arr[], int low, int mid, int high)",
      "{",
      "\tint i = low;",
      "\tint j = mid + 1;",
      "\tint k = 0;",
      "\tint temp[high - low + 1];",
      "",
      "\twhile(i <= mid && j <= high)",
      "\t{",
      "\t\tif(arr[i] < arr[j])",
      "\t\t{",
      "\t\t\ttemp[k] = arr[i];",
      "\t\t\ti++;",
      "\t\t}",
      "\t\telse",
      "\t\t{",
      "\t\t\ttemp[k] = arr[j];",
      "\t\t\tj++;",
      "\t\t}",
      "\t\tk++;",
      "\t}",
      "",
      "\twhile(i <= mid)",
      "\t{",
      "\t\ttemp[k] = arr[i];",
      "\t\ti++;",
      "\t\tk++;",
      "\t}",
      "",
      "\twhile(j <= high)",
      "\t{",
      "\t\ttemp[k] = arr[j];",
      "\t\tj++;",
      "\t\tk++;",
      "\t}",
      "",
      "\tfor(i = low, k = 0; i <= high; i++, k++)",
      "\t{",
      "\t\tarr[i] = temp[k];",
      "\t}",
      "}",
      "",
      "void mergeSort(int arr[], int low, int high)",
      "{",
      "\tif(low < high)",
      "\t{",
      "\t\tint mid = (low + high) / 2;",
      "",
      "\t\tmergeSort(arr, low, mid);",
      "\t\tmergeSort(arr, mid + 1, high);",
      "\t\tmerge(arr, low, mid, high);",
      "\t}",
      "}",
      "",
      "mergeSort(arr, 0, size - 1);",
      "$0"
    ],
    "description": "Merge Sort using Array"
  },
  "quick sort": {
    "prefix": "quick sort",
    "body": [
      "int partition(int arr[], int low, int high)",
      "{",
      "\tint pivot = arr[high];",
      "\tint i = low - 1;",
      "",
      "\tfor(int j = low; j < high; j++)",
      "\t{",
      "\t\tif(arr[j] < pivot)",
      "\t\t{",
      "\t\t\ti++;",
      "",
      "\t\t\tint temp = arr[i];",
      "\t\t\tarr[i] = arr[j];",
      "\t\t\tarr[j] = temp;",
      "\t\t}",
      "\t}",
      "",
      "\tint temp = arr[i + 1];",
      "\tarr[i + 1] = arr[high];",
      "\tarr[high] = temp;",
      "",
      "\treturn i + 1;",
      "}",
      "",
      "void quickSort(int arr[], int low, int high)",
      "{",
      "\tif(low < high)",
      "\t{",
      "\t\tint pi = partition(arr, low, high);",
      "",
      "\t\tquickSort(arr, low, pi - 1);",
      "\t\tquickSort(arr, pi + 1, high);",
      "\t}",
      "}",
      "",
      "quickSort(arr, 0, size - 1);",
      "$0"
    ],
    "description": "Quick Sort using Array"
  }
